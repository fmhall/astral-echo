{
  "name": "astral-echo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "seed": "bun run src/db/seed.ts",
    "lint": "oxlint src/",
    "format": "biome format --write src/",
    "check": "biome check src/ && oxlint src/",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.18.0",
    "@scalar/hono-api-reference": "^0.5.0",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.7.0",
    "mppx": "^0.1.0",
    "zod": "^3.25.30"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "^1.1.0",
    "drizzle-kit": "^0.30.0",
    "oxlint": "^0.16.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "bun@1.1.34"
}
